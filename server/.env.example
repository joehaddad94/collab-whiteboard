PORT=4000

# Origin of the React dev server, used for CORS (ADR-015) — must be an explicit
# origin, not a wildcard, since credentials/cookies are involved.
CLIENT_ORIGIN=http://localhost:5173

# Signing secret for JWTs (ADR-008). Generate a real random value for local use,
# e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Path to the SQLite database file (ADR-012), relative to server/.
DB_FILE=./data/whiteboard.sqlite
